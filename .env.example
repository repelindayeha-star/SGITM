# ---------------------------------------------------------------
# SIGTM - Moto Nexus | Plantilla de variables de entorno
#
# Copia este archivo como .env y completa los valores:
#     cp .env.example .env        (Linux / macOS)
#     copy .env.example .env      (Windows)
#
# El .env NO se sube al repositorio. Tampoco sus copias de
# seguridad: .gitignore ignora cualquier .env.*
# ---------------------------------------------------------------


# --- Base de datos ---------------------------------------------
# PostgreSQL en Neon. Es la MISMA cadena para los tres integrantes;
# pidesela al lider, no generes una nueva.
#
# IMPORTANTE: si la copias del panel de Neon, QUITA el parametro
# channel_binding=require. Prisma no lo soporta y la conexion falla
# con "Can't reach database server", que despista porque parece un
# problema de red y no lo es.
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST.neon.tech/neondb?sslmode=require"


# --- Sesiones ---------------------------------------------------
# Genera el tuyo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
JWT_EXPIRES_IN="8h"


# --- Servidor ---------------------------------------------------
PORT=3001
NODE_ENV="development"

# Origen permitido para CORS. La aplicacion NO arranca sin esta
# variable en produccion: es deliberado, para que nunca caiga a
# comodin en silencio (hallazgo SEG-05).
FRONTEND_URL="http://localhost:5173"


# --- reCAPTCHA de Google ---------------------------------------
# Se obtienen gratis en https://www.google.com/recaptcha/admin
# Usa reCAPTCHA v2 "No soy un robot" y anade localhost a la lista
# de dominios permitidos, o no funcionara en desarrollo.
# La clave de sitio va ADEMAS en frontend/.env como
# VITE_RECAPTCHA_SITE_KEY, y las dos tienen que ser del mismo par.
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""


# --- Correo saliente -------------------------------------------
# Mientras SMTP_HOST este vacio, los correos NO llegan al
# destinatario: se usa una bandeja de prueba (Ethereal) y el enlace
# para verlos se imprime en la consola del servidor. Sirve para
# desarrollar; no sirve para la demostracion.
#
# Brevo da 300 correos diarios gratis y no exige dominio propio:
#   SMTP_HOST="smtp-relay.brevo.com"
#   SMTP_PORT=587
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SIGTM Moto Nexus <no-responder@sigtm.com>"
