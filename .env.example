# Plantilla de configuracion del backend SIGTM.
# Copia este archivo como .env y completa los valores.
# El .env real NUNCA se sube al repositorio (ya esta en .gitignore).

# ── Base de datos ────────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/sigtm?schema=public"

# ── Autenticacion ────────────────────────────────────────────────
# Genera un secreto nuevo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── Servidor ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# URL del frontend. Se usa para el CORS y, mas adelante, para armar
# los enlaces de recuperacion de contrasena en los correos.
FRONTEND_URL=http://localhost:5173

# ── reCAPTCHA v2 ─────────────────────────────────────────────────
# Claves en https://www.google.com/recaptcha/admin
# La SITE_KEY es publica (va tambien en frontend/.env como
# VITE_RECAPTCHA_SITE_KEY). La SECRET_KEY nunca sale del servidor.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
