# Copiar como ".env" en la raiz del repo (junto a docker-compose.yml) y llenar con
# valores reales. Este archivo .env.docker.example SI se commitea (son placeholders);
# el .env real con los valores verdaderos NUNCA se commitea (ya esta en .gitignore).

# Cadena de conexion real de Neon (Settings -> Connection string en el dashboard de Neon)
DB_URL=jdbc:postgresql://ep-xxxxx.us-east-2.aws.neon.tech/motonexus?sslmode=require
DB_USER=por_definir
DB_PASSWORD=por_definir

# Generar con: openssl rand -base64 32
JWT_SECRET=por_definir
JWT_EXPIRATION_MINUTES=60

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=por_definir
MAIL_PASSWORD=por_definir

RECAPTCHA_SECRET=por_definir
RECAPTCHA_SITE_KEY=por_definir

GOOGLE_CLIENT_ID=por_definir

FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080/api
