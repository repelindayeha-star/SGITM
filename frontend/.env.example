# SIGTM - Moto Nexus | Variables del cliente
#
# Copia este archivo como frontend/.env
#
# Vite solo expone al navegador las variables que empiezan por VITE_.
# Por eso aqui NUNCA va un secreto: todo lo que este en este archivo
# acaba dentro del paquete que se descarga el navegador y cualquiera
# puede leerlo. La clave SECRETA del captcha va en el .env de la raiz,
# que solo ve el servidor.

# Direccion de la API. Incluye /api: es donde estan montadas las rutas.
VITE_API_URL=http://localhost:3001/api

# Clave de SITIO del reCAPTCHA (la publica). Tiene que ser del mismo par
# que RECAPTCHA_SECRET_KEY del .env de la raiz.
VITE_RECAPTCHA_SITE_KEY=
