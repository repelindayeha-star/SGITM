# Credenciales. Se ignora cualquier variante (.env.local, .env.backup-...)
# porque una copia de seguridad del .env lleva los mismos secretos que el
# original, y es justo la que se sube sin darse cuenta.
.env
.env.*
!.env.example

uploads/*
!uploads/.gitkeep

