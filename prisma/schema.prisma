generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMINISTRADOR
  RECEPCIONISTA
  MECANICO
  CLIENTE
}

model Usuario {
  id        String     @id @default(uuid())
  nombre    String
  email     String     @unique
  password  String
  rol       RolUsuario @default(CLIENTE)
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  cliente          Cliente?
  ordenesAsignadas OrdenTrabajo[]

  @@map("usuarios")
}
model Cliente {
  id            String         @id @default(uuid())
  usuarioId     String         @unique
  usuario       Usuario        @relation(fields: [usuarioId], references: [id])
  telefono      String
  direccion     String?
  motocicletas  Motocicleta[]
  citas         Cita[]
  ordenes       OrdenTrabajo[]
  createdAt     DateTime       @default(now())

  @@map("clientes")
}

model Motocicleta {
  id         String         @id @default(uuid())
  clienteId  String
  cliente    Cliente        @relation(fields: [clienteId], references: [id])
  placa      String         @unique
  marca      String
  modelo     String
  anio       Int
  color      String?
  citas      Cita[]
  ordenes    OrdenTrabajo[]
  createdAt  DateTime       @default(now())

  @@map("motocicletas")
}

enum EstadoCita {
  PROGRAMADA
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

model Cita {
  id            String      @id @default(uuid())
  clienteId     String
  cliente       Cliente     @relation(fields: [clienteId], references: [id])
  motocicletaId String
  motocicleta   Motocicleta @relation(fields: [motocicletaId], references: [id])
  fechaHora     DateTime
  motivo        String
  estado        EstadoCita  @default(PROGRAMADA)
  createdAt     DateTime    @default(now())

  @@map("citas")
}

enum EstadoOrden {
  RECIBIDA
  EN_DIAGNOSTICO
  EN_COTIZACION
  APROBADA
  EN_REPARACION
  LISTA
  ENTREGADA
  CANCELADA
}

model OrdenTrabajo {
  id            String       @id @default(uuid())
  codigo        String       @unique  // código público para seguimiento (QR)
  clienteId     String
  cliente       Cliente      @relation(fields: [clienteId], references: [id])
  motocicletaId String
  motocicleta   Motocicleta  @relation(fields: [motocicletaId], references: [id])
  mecanicoId    String?
  mecanico      Usuario?     @relation(fields: [mecanicoId], references: [id])
  estado        EstadoOrden  @default(RECIBIDA)
  descripcionProblema String
  observaciones String?
  fechaRecibido DateTime     @default(now())
  fechaEntrega  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  diagnostico   Diagnostico?
  factura       Factura?

  @@map("ordenes_trabajo")
}
model Diagnostico {
  id                String       @id @default(uuid())
  ordenId           String       @unique
  orden             OrdenTrabajo @relation(fields: [ordenId], references: [id])
  descripcion       String
  manoObra          Decimal      @db.Decimal(10, 2)
  createdAt         DateTime     @default(now())

  itemsCotizacion    ItemCotizacion[]

  @@map("diagnosticos")
}

model ItemCotizacion {
  id             String       @id @default(uuid())
  diagnosticoId  String
  diagnostico    Diagnostico  @relation(fields: [diagnosticoId], references: [id])
  repuestoId     String?
  repuesto       Repuesto?    @relation(fields: [repuestoId], references: [id])
  descripcion    String
  cantidad       Int          @default(1)
  precioUnitario Decimal      @db.Decimal(10, 2)

  @@map("items_cotizacion")
}

model Repuesto {
  id            String            @id @default(uuid())
  nombre        String
  codigo        String            @unique
  stock         Int               @default(0)
  stockMinimo   Int               @default(5)
  precio        Decimal           @db.Decimal(10, 2)
  createdAt     DateTime          @default(now())

  itemsCotizacion ItemCotizacion[]
  movimientos     MovimientoInventario[]

  @@map("repuestos")
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
}

model MovimientoInventario {
  id           String         @id @default(uuid())
  repuestoId   String
  repuesto     Repuesto       @relation(fields: [repuestoId], references: [id])
  tipo         TipoMovimiento
  cantidad     Int
  motivo       String
  createdAt    DateTime       @default(now())

  @@map("movimientos_inventario")
}

model Factura {
  id           String       @id @default(uuid())
  ordenId      String       @unique
  orden        OrdenTrabajo @relation(fields: [ordenId], references: [id])
  numero       String       @unique
  subtotal     Decimal      @db.Decimal(10, 2)
  total        Decimal      @db.Decimal(10, 2)
  metodoPago   String
  createdAt    DateTime     @default(now())

  @@map("facturas")
}